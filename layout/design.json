  "dataModels": {
    "equipment": {
      "fields": [
        "name",
        "equipmentCategory",
        "company",
        "usedBy",
        "maintenanceTeam",
        "assignedDate",
        "technician",
        "employee",
        "scrapDate",
        "usedInLocation",
        "workContact",
        "description",
        "serialNumber",
        "department"
