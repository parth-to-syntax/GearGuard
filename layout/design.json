{
  "application": {
    "name": "Maintenance Management System",
    "description": "A comprehensive equipment maintenance tracking and management system",
    "type": "Web Application"
  },
  "pages": [
    {
      "id": "login",
      "name": "Login Page",
      "route": "/login",
      "layout": "centered",
      "components": [
        {
          "type": "form",
          "fields": [
            {
              "name": "email",
              "label": "Email id",
              "type": "text",
              "required": true,
              "validation": "email"
            },
            {
              "name": "password",
              "label": "Password",
              "type": "password",
              "required": true
            }
          ],
          "actions": [
            {
              "type": "button",
              "label": "Sign in",
              "style": "primary",
              "action": "submit"
            }
          ],
          "links": [
            {
              "text": "Forget Password ?",
              "route": "/forgot-password",
              "style": "link"
            },
            {
              "text": "Sign Up",
              "route": "/signup",
              "style": "link"
            }
          ]
        }
      ],
      "validation": {
        "loginCheck": "Check for login credentials",
        "matchCredentials": "Match credentials and allow login",
        "accountNotFound": "If email not found, show error 'Account not exist'",
        "passwordMismatch": "If password doesn't match, show error 'Invalid Password'",
        "signUpRedirect": "When clicked on SignUp, load SignUp page and only portal user will be created"
      }
    },
    {
      "id": "signup",
      "name": "Sign Up Page",
      "route": "/signup",
      "layout": "centered",
      "components": [
        {
          "type": "form",
          "fields": [
            {
              "name": "name",
              "label": "Name",
              "type": "text",
              "required": true
            },
            {
              "name": "email",
              "label": "Email id",
              "type": "text",
              "required": true,
              "validation": "email"
            },
            {
              "name": "password",
              "label": "Password",
              "type": "password",
              "required": true,
              "validation": "Must be unique and must contain a small case, a large case and a special character and length should be more than 8 characters"
            },
            {
              "name": "confirmPassword",
              "label": "Re-Enter password",
              "type": "password",
              "required": true,
              "validation": "Must match password field"
            }
          ],
          "actions": [
            {
              "type": "button",
              "label": "Sign Up",
              "style": "primary",
              "action": "submit"
            }
          ]
        }
      ],
      "validation": {
        "createPortalUser": "Create a portal user database in the system on signup",
        "checkCredentials": "Check credentials as follows",
        "passwordRequirements": [
          "Must be unique",
          "Must contain a small case letter",
          "Must contain a large case letter",
          "Must contain a special character",
          "Length should be more than 8 characters"
        ],
        "emailDuplicate": "Email must be unique and must not be a duplicate in database"
      }
    },
    {
      "id": "dashboard",
      "name": "Dashboard",
      "route": "/dashboard",
      "layout": "full-width",
      "navigation": {
        "tabs": [
          "Maintenance",
          "Dashboard",
          "Maintenance Calendar",
          "Equipment",
          "Reporting",
          "Teams"
        ],
        "activeTab": "Dashboard"
      },
      "components": [
        {
          "type": "header",
          "elements": [
            {
              "type": "button",
              "label": "New",
              "style": "primary",
              "action": "createNewRequest"
            },
            {
              "type": "search",
              "placeholder": "Search...",
              "width": "medium"
            }
          ]
        },
        {
          "type": "kpiCards",
          "cards": [
            {
              "id": "criticalEquipment",
              "title": "Critical Equipment",
              "value": "5 Units",
              "subtitle": "(Health < 30%)",
              "backgroundColor": "red",
              "description": "Red background card displaying the count of at-risk machines. Helps managers identify assets that need immediate replacement or major overhaul."
            },
            {
              "id": "technicianLoad",
              "title": "Technician Load",
              "value": "85% Utilized",
              "subtitle": "(Assign Carefully)",
              "backgroundColor": "blue",
              "description": "Blue background card displaying workforce utilization percentage.",
              "note": "In Equipment 2 option: 1. Work center, 2. Machine & Tools (where equipment is created)"
            },
            {
              "id": "openRequests",
              "title": "Open Requests",
              "value": "12 Pending",
              "subtitle": "3 Overdue",
              "backgroundColor": "green",
              "description": "Display the status where request are in."
            }
          ]
        },
        {
          "type": "dataTable",
          "title": "Maintenance Reports",
          "description": "For requests to track the process",
          "columns": [
            {
              "field": "subject",
              "header": "Subject",
              "width": "20%"
            },
            {
              "field": "technicianName",
              "header": "Technician Name",
              "width": "15%"
            },
            {
              "field": "equipment",
              "header": "Equipment",
              "width": "20%"
            },
            {
              "field": "workcenter",
              "header": "Workcenter",
              "width": "15%"
            },
            {
              "field": "company",
              "header": "Company",
              "width": "20%"
            },
            {
              "field": "status",
              "header": "Status",
              "width": "10%",
              "type": "badge"
            }
          ],
          "sampleData": [
            {
              "subject": "Test activity",
              "technicianName": "Mitchell Adam",
              "equipment": "Acer Laptop/LP/2025/M2S912S",
              "workcenter": "Computers",
              "company": "My company",
              "status": "New Request"
            }
          ],
          "features": [
            "Sortable columns",
            "Filterable",
            "Row click to view details"
          ]
        }
      ]
    },
    {
      "id": "maintenanceRequest",
      "name": "Maintenance Request Form",
      "route": "/maintenance/new",
      "layout": "centered-wide",
      "requestTypes": [
        {
          "id": "equipment",
          "label": "Equipment",
          "description": "Request for equipment maintenance"
        },
        {
          "id": "workCenter",
          "label": "Work Center",
          "description": "If work center is selected, instead of equipment field, there should be Work center field then one have to select specific work center where the request should be done"
        }
      ],
      "components": [
        {
          "type": "form",
          "sections": [
            {
              "title": "Request Details",
              "fields": [
                {
                  "name": "subject",
                  "label": "Subject",
                  "type": "text",
                  "required": true,
                  "placeholder": "Test activity"
                },
                {
                  "name": "createdBy",
                  "label": "Created By",
                  "type": "text",
                  "readonly": true,
                  "value": "Mitchell Adam"
                },
                {
                  "name": "maintenanceFor",
                  "label": "Maintenance For",
                  "type": "select",
                  "required": true,
                  "options": "equipmentList",
                  "description": "Selection of equipment which created in equipment model",
                  "note": "Shows as dropdown: Acer Laptop/LP/2025/M2S912S"
                },
                {
                  "name": "equipment",
                  "label": "Equipment",
                  "type": "display",
                  "value": "Computers",
                  "description": "Auto-populated from selected equipment"
                },
                {
                  "name": "category",
                  "label": "Category",
                  "type": "display",
                  "value": "12/18/2025"
                },
                {
                  "name": "requestDate",
                  "label": "Request Date?",
                  "type": "date",
                  "required": true
                },
                {
                  "name": "maintenanceType",
                  "label": "Maintenance Type",
                  "type": "radio",
                  "required": true,
                  "options": [
                    {
                      "value": "corrective",
                      "label": "Corrective",
                      "selected": true
                    },
                    {
                      "value": "preventive",
                      "label": "Preventive"
                    }
                  ]
                }
              ]
            },
            {
              "title": "Assignment",
              "fields": [
                {
                  "name": "team",
                  "label": "Team",
                  "type": "select",
                  "value": "Internal Maintenance"
                },
                {
                  "name": "technician",
                  "label": "Technician",
                  "type": "select",
                  "value": "Alex Foster"
                },
                {
                  "name": "scheduledDate",
                  "label": "Scheduled Date?",
                  "type": "datetime",
                  "value": "12/28/2025 14:30:00"
                },
                {
                  "name": "duration",
                  "label": "Duration",
                  "type": "time",
                  "value": "00:00 hours"
                },
                {
                  "name": "priority",
                  "label": "Priority",
                  "type": "select",
                  "options": ["Low", "Medium", "High"],
                  "style": "diamond-selector"
                },
                {
                  "name": "company",
                  "label": "Company",
                  "type": "select",
                  "value": "My Company (San Francisco)"
                }
              ]
            },
            {
              "title": "Notes",
              "fields": [
                {
                  "name": "notes",
                  "type": "textarea",
                  "height": "large",
                  "tabs": ["Notes", "Instructions"]
                }
              ]
            }
          ],
          "statusIndicator": {
            "type": "workflow",
            "stages": [
              {
                "name": "New Request",
                "state": "active"
              },
              {
                "name": "In Progress",
                "state": "inactive"
              },
              {
                "name": "Reopened",
                "state": "inactive"
              },
              {
                "name": "Scrap",
                "state": "inactive"
              }
            ],
            "colorCoding": {
              "inProgress": "blue",
              "reopened": "yellow",
              "readyForNextStage": "green"
            }
          },
          "commentSection": {
            "type": "comments",
            "label": "Smart button that open the worksheet comment section"
          }
        }
      ]
    },
    {
      "id": "maintenanceCalendar",
      "name": "Maintenance Calendar",
      "route": "/maintenance/calendar",
      "layout": "full-width",
      "components": [
        {
          "type": "calendar",
          "view": "week",
          "timeRange": {
            "start": "00:00",
            "end": "24:00",
            "interval": "30min"
          },
          "features": [
            "Show scheduled requests",
            "Color-coded by status",
            "Click to view details",
            "Drag to reschedule"
          ],
          "legend": [
            {
              "color": "red",
              "label": "Overdue"
            },
            {
              "color": "blue",
              "label": "Scheduled"
            },
            {
              "color": "green",
              "label": "Completed"
            }
          ],
          "miniCalendar": {
            "position": "top-right",
            "showMonth": true,
            "highlightScheduledDays": true
          }
        }
      ],
      "note": "In calendar scheduled request should be shown"
    },
