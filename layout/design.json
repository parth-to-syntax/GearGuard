    "cardStyles": {
      "criticalEquipment": {
        "backgroundColor": "red",
        "textColor": "white"
      },
      "technicianLoad": {
        "backgroundColor": "blue",
        "textColor": "white"
      },
      "openRequests": {
        "backgroundColor": "green",
        "textColor": "white"
      }
    },
    "typography": {
      "fontFamily": "system-ui, -apple-system, sans-serif",
      "headings": {
        "h1": "2rem",
        "h2": "1.5rem",
        "h3": "1.25rem"
      }
    },
    "spacing": {
      "small": "8px",
      "medium": "16px",
      "large": "24px",
      "xlarge": "32px"
    },
    "components": {
      "button": {
        "primary": {
          "backgroundColor": "#007bff",
          "color": "white",
          "borderRadius": "4px",
          "padding": "8px 16px"
        },
        "secondary": {
          "backgroundColor": "transparent",
          "color": "#007bff",
          "border": "1px solid #007bff",
          "borderRadius": "4px",
          "padding": "8px 16px"
        }
      },
      "form": {
        "inputHeight": "38px",
        "labelWeight": "500",
        "borderColor": "#ced4da",
        "borderRadius": "4px"
      },
      "table": {
        "headerBackground": "#f8f9fa",
        "rowHoverBackground": "#f1f3f5",
        "borderColor": "#dee2e6"
      }
    }
  },
  "features": {
    "authentication": {
      "enabled": true,
      "methods": ["email-password"],
      "passwordRequirements": {
        "minLength": 8,
        "requireUppercase": true,
        "requireLowercase": true,
        "requireSpecialChar": true
      }
    },
    "notifications": {
      "enabled": true,
      "types": ["success", "error", "warning", "info"]
    },
    "search": {
      "enabled": true,
      "scope": "global",
      "entities": ["equipment", "maintenanceRequest", "workCenter"]
    },
    "export": {
      "enabled": true,
      "formats": ["CSV", "Excel", "PDF"]
    },
    "reporting": {
      "enabled": true,
      "dashboards": ["maintenance", "equipment", "technician"],
      "reports": [
        {
          "name": "Equipment Health Report",
          "description": "Shows equipment health status and maintenance history"
        },
        {
          "name": "Technician Workload Report",
          "description": "Displays technician utilization and task distribution"
        },
        {
          "name": "Maintenance Cost Report",
          "description": "Tracks maintenance costs by equipment and time period"
        },
        {
          "name": "Downtime Analysis",
          "description": "Analyzes equipment downtime and maintenance efficiency"
        }
      ]
    }
  },
  "workflow": {
    "maintenanceRequest": {
      "stages": [
        {
          "name": "New Request",
          "color": "gray",
          "nextStages": ["In Progress"],
          "actions": ["Assign technician", "Schedule"]
        },
        {
          "name": "In Progress",
          "color": "blue",
          "nextStages": ["Reopened", "Completed"],
          "actions": ["Update progress", "Add notes", "Request parts"]
        },
        {
          "name": "Reopened",
          "color": "yellow",
          "nextStages": ["In Progress", "Scrap"],
          "actions": ["Reassign", "Update priority"]
        },
        {
          "name": "Completed",
          "color": "green",
          "nextStages": [],
          "actions": ["Archive", "Generate report"]
        },
        {
          "name": "Scrap",
          "color": "red",
          "nextStages": [],
          "actions": ["Archive", "Generate report"]
        }
      ]
    }
  },
  "permissions": {
    "roles": {
      "portal": {
        "canView": ["own_requests"],
        "canCreate": ["maintenance_request"],
        "canEdit": ["own_requests"],
        "canDelete": [],
        "description": "Basic user who can only create and view their own requests"
      },
      "technician": {
        "canView": ["assigned_requests", "equipment", "workCenter"],
        "canCreate": ["maintenance_request"],
        "canEdit": ["assigned_requests", "equipment_status"],
        "canDelete": [],
        "description": "Technician who can work on assigned requests and update equipment"
      },
      "manager": {
        "canView": ["all_requests", "equipment", "workCenter", "teams", "reports"],
        "canCreate": ["maintenance_request", "equipment", "workCenter", "teams"],
        "canEdit": ["all_requests", "equipment", "workCenter", "teams"],
        "canDelete": ["maintenance_request"],
        "description": "Manager with full access to manage maintenance operations"
      },
      "admin": {
        "canView": ["all"],
        "canCreate": ["all"],
        "canEdit": ["all"],
        "canDelete": ["all"],
        "description": "Administrator with full system access"
      }
    }
  },
  "apiEndpoints": {
    "authentication": {
      "login": {
        "method": "POST",
        "path": "/api/auth/login",
        "body": ["email", "password"],
        "response": ["token", "user"]
      },
      "signup": {
        "method": "POST",
        "path": "/api/auth/signup",
        "body": ["name", "email", "password"],
        "response": ["token", "user"]
      },
      "logout": {
        "method": "POST",
        "path": "/api/auth/logout",
        "response": ["success"]
      }
    },
    "maintenanceRequests": {
      "list": {
        "method": "GET",
        "path": "/api/maintenance-requests",
        "query": ["status", "technician", "dateRange", "page", "limit"]
      },
      "create": {
        "method": "POST",
        "path": "/api/maintenance-requests",
        "body": ["subject", "requestType", "maintenanceFor", "requestDate", "maintenanceType", "team", "technician", "priority"]
      },
      "get": {
        "method": "GET",
        "path": "/api/maintenance-requests/:id"
      },
      "update": {
        "method": "PUT",
        "path": "/api/maintenance-requests/:id",
        "body": ["any field"]
      },
      "delete": {
        "method": "DELETE",
        "path": "/api/maintenance-requests/:id"
      },
      "updateStatus": {
        "method": "PATCH",
        "path": "/api/maintenance-requests/:id/status",
        "body": ["status"]
      }
    },
    "equipment": {
      "list": {
        "method": "GET",
        "path": "/api/equipment",
        "query": ["category", "company", "status", "page", "limit"]
      },
      "create": {
        "method": "POST",
        "path": "/api/equipment",
        "body": ["name", "equipmentCategory", "company", "usedBy", "maintenanceTeam"]
      },
      "get": {
        "method": "GET",
        "path": "/api/equipment/:id"
      },
      "update": {
        "method": "PUT",
        "path": "/api/equipment/:id"
      },
      "delete": {
        "method": "DELETE",
        "path": "/api/equipment/:id"
      }
    },
    "equipmentCategories": {
      "list": {
        "method": "GET",
        "path": "/api/equipment-categories"
      },
      "create": {
        "method": "POST",
        "path": "/api/equipment-categories",
        "body": ["name", "responsible", "company"]
      },
      "update": {
        "method": "PUT",
        "path": "/api/equipment-categories/:id"
      },
      "delete": {
        "method": "DELETE",
        "path": "/api/equipment-categories/:id"
      }
    },
    "workCenters": {
      "list": {
        "method": "GET",
        "path": "/api/work-centers"
      },
      "create": {
        "method": "POST",
        "path": "/api/work-centers",
        "body": ["workCenter", "code", "tag", "costPerHour"]
      },
      "get": {
        "method": "GET",
        "path": "/api/work-centers/:id"
      },
      "update": {
        "method": "PUT",
        "path": "/api/work-centers/:id"
      },
      "delete": {
        "method": "DELETE",
        "path": "/api/work-centers/:id"
      }
    },
    "teams": {
      "list": {
        "method": "GET",
        "path": "/api/teams"
      },
      "create": {
        "method": "POST",
        "path": "/api/teams",
        "body": ["teamName", "teamMembers", "company"]
      },
      "get": {
        "method": "GET",
        "path": "/api/teams/:id"
      },
      "update": {
        "method": "PUT",
        "path": "/api/teams/:id"
      },
      "delete": {
        "method": "DELETE",
        "path": "/api/teams/:id"
      }
    },
    "dashboard": {
      "kpis": {
        "method": "GET",
        "path": "/api/dashboard/kpis",
        "response": ["criticalEquipment", "technicianLoad", "openRequests"]
      },
      "recentRequests": {
        "method": "GET",
        "path": "/api/dashboard/recent-requests",
        "query": ["limit"]
      }
    },
    "calendar": {
      "events": {
        "method": "GET",
        "path": "/api/calendar/events",
        "query": ["startDate", "endDate"]
      }
    }
  },
  "integrations": {
    "email": {
      "enabled": true,
      "triggers": [
        "New request created",
        "Request assigned to technician",
        "Request status changed",
        "Request overdue",
        "Request completed"
      ]
    },
    "calendar": {
      "enabled": true,
      "syncWith": ["Google Calendar", "Outlook Calendar"],
      "features": ["Scheduled maintenance sync", "Technician availability"]
    }
  },
  "validationRules": {
    "maintenanceRequest": {
      "subject": {
        "required": true,
        "minLength": 3,
        "maxLength": 200
      },
      "requestDate": {
        "required": true,
        "minDate": "today"
      },
      "scheduledDate": {
        "minDate": "requestDate"
      },
      "conditionalFields": {
        "ifEquipmentType": {
          "showFields": ["maintenanceFor", "equipment"],
          "hideFields": ["workCenter"]
        },
        "ifWorkCenterType": {
          "showFields": ["workCenter"],
          "hideFields": ["maintenanceFor", "equipment"]
        }
      }
    },
    "equipment": {
      "name": {
        "required": true,
        "unique": true
      },
      "equipmentCategory": {
        "required": true
      },
      "company": {
        "required": true
      }
    },
    "user": {
      "email": {
        "required": true,
        "format": "email",
        "unique": true
      },
      "password": {
        "required": true,
        "minLength": 8,
        "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*[!@#$%^&*])",
        "message": "Password must contain at least one lowercase letter, one uppercase letter, and one special character"
      }
    }
  }
}